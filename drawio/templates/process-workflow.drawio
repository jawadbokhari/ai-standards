<mxfile host="65bd71144e">
    <diagram name="Process Workflow" id="pw-template">
        <mxGraphModel dx="1187" dy="579" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="pw-title" value="[Process / Workflow Title]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="50" y="20" width="727" height="40" as="geometry"/>
                </mxCell>

                <!-- Lane 1: startSize=30 (thin label strip on left) -->
                <mxCell id="pw-lane1" value="[Team A&#xa;/ Role A]" style="swimlane;startSize=30;horizontal=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;fontStyle=1;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="50" y="80" width="727" height="220" as="geometry"/>
                </mxCell>

                <!-- Start event: vertically centered, 40px left of Task 1 -->
                <mxCell id="pw-start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=10;" parent="pw-lane1" vertex="1">
                    <mxGeometry x="50" y="80" width="60" height="60" as="geometry"/>
                </mxCell>

                <!-- Task 1: 40px gap from Start right edge (50+60+40=150) -->
                <mxCell id="pw-task-1" value="[Task 1]&#xa;Description of what happens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;fontFamily=Helvetica;fontSize=10;" parent="pw-lane1" vertex="1">
                    <mxGeometry x="150" y="75" width="160" height="70" as="geometry"/>
                </mxCell>

                <!-- Task 2: 40px gap from Task 1 right edge (150+160+40=350) -->
                <mxCell id="pw-task-2" value="[Task 2]&#xa;Description of what happens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;fontFamily=Helvetica;fontSize=10;" parent="pw-lane1" vertex="1">
                    <mxGeometry x="350" y="75" width="160" height="70" as="geometry"/>
                </mxCell>

                <!-- Gateway: 40px gap from Task 2 right edge (350+160+40=550) -->
                <mxCell id="pw-gw1" value="[Decision?]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;fontStyle=1;fontFamily=Helvetica;fontSize=9;" parent="pw-lane1" vertex="1">
                    <mxGeometry x="550" y="70" width="90" height="80" as="geometry"/>
                </mxCell>

                <!-- Edges: all with explicit connection anchors -->
                <mxCell id="pw-edge-start-t1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="pw-lane1" source="pw-start" target="pw-task-1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pw-edge-t1-t2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="pw-lane1" source="pw-task-1" target="pw-task-2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pw-edge-t2-gw" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="pw-lane1" source="pw-task-2" target="pw-gw1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- "No" loop: exits top of gateway, arcs above all shapes (y=30), re-enters top of Task 1 -->
                <mxCell id="pw-edge-gw-no" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="pw-lane1" source="pw-gw1" target="pw-task-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="595" y="30"/>
                            <mxPoint x="230" y="30"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- Lane 2: startSize=30 (thin label strip on left) -->
                <mxCell id="pw-lane2" value="[Team B&#xa;/ Role B]" style="swimlane;startSize=30;horizontal=0;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=1;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1">
