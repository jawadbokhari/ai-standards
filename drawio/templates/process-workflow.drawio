                <mxCell id="pw-edge-t3-t4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="pw-lane2" source="pw-task-3" target="pw-task-4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pw-edge-t4-end" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="pw-lane2" source="pw-task-4" target="pw-end" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- "Yes" cross-lane edge: parent="1" (page root), explicit waypoints through the inter-lane gap -->
                <!-- page coords: gw1 center-x = 50(lane1-x)+550+45=645, lane1 bottom = 50+80+220=350, lane2 top = 50+340=390 -->
                <!-- task3 center-x = 50(lane2-x)+150+80=280, task3 top in page = 50+340+75=465 -->
