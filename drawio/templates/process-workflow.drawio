                <!-- Annotation and legend (below the lanes) -->
                <mxCell id="pw-note" value="[Add notes or annotations here]" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=middle;spacingLeft=5;rounded=1;fontFamily=Helvetica;fontSize=9;fontStyle=2;" parent="1" vertex="1">
