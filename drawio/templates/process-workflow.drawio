                <!-- Task 3: aligned under Gateway "Yes" path, vertically centered -->
                <mxCell id="pw-task-3" value="[Task 3]&#xa;Description of what happens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=10;" parent="pw-lane2" vertex="1">
                    <mxGeometry x="150" y="75" width="160" height="70" as="geometry"/>
                </mxCell>

                <!-- Task 4: 40px gap from Task 3 (150+160+40=350) -->
                <mxCell id="pw-task-4" value="[Task 4]&#xa;Description of what happens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=10;" parent="pw-lane2" vertex="1">
                    <mxGeometry x="350" y="75" width="160" height="70" as="geometry"/>
                </mxCell>

                <!-- End event: 40px gap from Task 4 (350+160+40=550) -->
                <mxCell id="pw-end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=10;strokeWidth=3;" parent="pw-lane2" vertex="1">
                    <mxGeometry x="550" y="80" width="60" height="60" as="geometry"/>
