<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="Deployment" id="dep-template">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="dep-title" value="[Deployment Topology Title]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="727" height="40" as="geometry"/>
        </mxCell>

        <!-- Zone 1: Internet / External -->
        <mxCell id="dep-zone-ext" value="Internet / External" style="swimlane;startSize=25;dashed=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontStyle=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="727" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="dep-client" value="[Client Browser / App]&#xa;Port: 443 (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-ext">
          <mxGeometry x="60" y="30" width="170" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dep-channel" value="[WhatsApp / Twilio / External Channel]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-ext">
          <mxGeometry x="490" y="30" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- Zone 2: DMZ / Edge -->
        <mxCell id="dep-zone-dmz" value="DMZ / Edge Layer" style="swimlane;startSize=25;dashed=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;fontStyle=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="727" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dep-lb" value="Load Balancer&#xa;Port: 80, 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-dmz">
          <mxGeometry x="60" y="35" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="dep-gw" value="[API Gateway / APISIX]&#xa;Port: 9080 (HTTP) / 9443 (HTTPS)&#xa;Auth · Rate Limit · Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-dmz">
          <mxGeometry x="260" y="25" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Zone 3: Application Servers -->
        <mxCell id="dep-zone-app" value="Application Layer" style="swimlane;startSize=25;dashed=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="320" width="727" height="200" as="geometry"/>
        </mxCell>

        <!-- App Server 1 -->
        <mxCell id="dep-host-1" value="[Host / Node 1]" style="swimlane;startSize=20;dashed=1;fillColor=#F9F0FF;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=2;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="dep-zone-app">
          <mxGeometry x="30" y="35" width="200" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-a" value="[Service A]&#xa;Port: 8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-1">
          <mxGeometry x="20" y="30" width="155" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-b" value="[Service B]&#xa;Port: 8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-1">
          <mxGeometry x="20" y="90" width="155" height="40" as="geometry"/>
        </mxCell>

        <!-- App Server 2 -->
        <mxCell id="dep-host-2" value="[Host / Node 2]" style="swimlane;startSize=20;dashed=1;fillColor=#F9F0FF;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=2;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="dep-zone-app">
          <mxGeometry x="265" y="35" width="200" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-c" value="[Service C]&#xa;Port: 9000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-2">
          <mxGeometry x="20" y="30" width="155" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-d" value="[Service D]&#xa;Port: 9001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-2">
          <mxGeometry x="20" y="90" width="155" height="40" as="geometry"/>
        </mxCell>

        <!-- App Server 3 (channels) -->
        <mxCell id="dep-host-3" value="[Host / Node 3]" style="swimlane;startSize=20;dashed=1;fillColor=#F9F0FF;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=2;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="dep-zone-app">
          <mxGeometry x="500" y="35" width="200" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-e" value="[Channel Connector A]&#xa;Port: 7000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-3">
          <mxGeometry x="20" y="30" width="155" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dep-svc-f" value="[Channel Connector B]&#xa;Port: 7001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-host-3">
          <mxGeometry x="20" y="90" width="155" height="40" as="geometry"/>
        </mxCell>

        <!-- Zone 4: Data Layer -->
        <mxCell id="dep-zone-data" value="Data Layer" style="swimlane;startSize=25;dashed=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontStyle=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="727" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="dep-db" value="[PostgreSQL]&#xa;Port: 5432" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-data">
          <mxGeometry x="50" y="30" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dep-redis" value="[Redis]&#xa;Port: 6379" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-data">
          <mxGeometry x="200" y="30" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dep-minio" value="[MinIO]&#xa;Port: 9000" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-data">
          <mxGeometry x="350" y="30" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dep-queue" value="[RabbitMQ / Kafka]&#xa;Port: 5672" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="dep-zone-data">
          <mxGeometry x="500" y="30" width="130" height="70" as="geometry"/>
        </mxCell>

        <!-- Connections: all with explicit connection anchors -->
        <!-- client (bottom) → lb (top): vertical T→B across Internet→DMZ zone boundary -->
        <mxCell id="dep-edge-client-lb" value="HTTPS:443" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dep-client" target="dep-lb" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- lb (right) → gw (left): horizontal L→R within DMZ zone -->
        <mxCell id="dep-edge-lb-gw" value="HTTP:9080" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="dep-lb" target="dep-gw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- gw (bottom) → svc-a (top): vertical T→B across DMZ→App zone boundary -->
        <mxCell id="dep-edge-gw-svc-a" value="HTTP:8080" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dep-gw" target="dep-svc-a" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- svc-a (bottom) → db (top): vertical T→B across App→Data zone boundary -->
        <mxCell id="dep-edge-svc-a-db" value="TCP:5432" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;dashed=1;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dep-svc-a" target="dep-db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- channel (bottom) → svc-e (top): vertical T→B across Internet→App zone boundary -->
        <mxCell id="dep-edge-channel-svc-e" value="HTTPS:443" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="dep-channel" target="dep-svc-e" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="dep-leg-title" value="Legend:" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="60" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="dep-leg-solid" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="730" as="sourcePoint"/>
            <mxPoint x="110" y="730" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-leg-solid-lbl" value="Sync / HTTP call" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="120" y="722" width="120" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="dep-leg-dash" value="" style="endArrow=block;endFill=1;dashed=1;html=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="730" as="sourcePoint"/>
            <mxPoint x="320" y="730" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-leg-dash-lbl" value="Async / internal (TCP, queue)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="330" y="722" width="180" height="16" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
