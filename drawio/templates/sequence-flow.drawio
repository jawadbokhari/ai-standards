<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="Sequence Flow" id="sq-template">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="sq-title" value="[Sequence Flow Title]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="727" height="40" as="geometry"/>
        </mxCell>

        <!-- Participant boxes -->
        <mxCell id="sq-p1" value="[Actor / User]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;fontStyle=1;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="sq-p2" value="[Service A]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=1;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="sq-p3" value="[Service B]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontStyle=1;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="sq-p4" value="[External System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontStyle=1;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="80" width="127" height="45" as="geometry"/>
        </mxCell>

        <!--
          Lifelines: dashed vertical lines extending from each participant.
          Sequence diagram exception (per DRAW_IO_STANDARDS.md §8.3):
          Message arrows use floating sourcePoint/targetPoint geometry instead
          of source/target node references. This allows precise Y-axis positioning
          to show the time sequence. Lifelines use the same floating pattern —
          all four use consistent mxGeometry with sourcePoint/targetPoint only.
          To extend lifelines: increase the targetPoint y value and move the legend down.
        -->
        <mxCell id="sq-life-1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="125" as="sourcePoint"/>
            <mxPoint x="140" y="870" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-life-2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="125" as="sourcePoint"/>
            <mxPoint x="340" y="870" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-life-3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="125" as="sourcePoint"/>
            <mxPoint x="540" y="870" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-life-4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#757575;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="713" y="125" as="sourcePoint"/>
            <mxPoint x="713" y="870" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message 1: Actor → Service A -->
        <mxCell id="sq-msg-1" value="1. [Request / Action]" style="html=1;endArrow=block;endFill=1;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry x="140" y="180" relative="1" as="geometry">
            <mxPoint x="140" y="180" as="sourcePoint"/>
            <mxPoint x="340" y="180" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Activation box on Service A -->
        <mxCell id="sq-act-2a" value="" style="fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="20" height="100" as="geometry"/>
        </mxCell>

        <!-- Message 2: Service A → Service B -->
        <mxCell id="sq-msg-2" value="2. [Internal Call]" style="html=1;endArrow=block;endFill=1;edgeStyle=elbowEdgeStyle;elbow=vertical;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="230" as="sourcePoint"/>
            <mxPoint x="540" y="230" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Activation box on Service B -->
        <mxCell id="sq-act-3a" value="" style="fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="530" y="230" width="20" height="80" as="geometry"/>
        </mxCell>

        <!-- Message 3: Service B → External -->
        <mxCell id="sq-msg-3" value="3. [External API Call]" style="html=1;endArrow=block;endFill=1;edgeStyle=elbowEdgeStyle;elbow=vertical;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="270" as="sourcePoint"/>
            <mxPoint x="713" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message 4: External → Service B (return) -->
        <mxCell id="sq-msg-4" value="4. [Response]" style="html=1;endArrow=open;endFill=0;edgeStyle=elbowEdgeStyle;elbow=vertical;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="713" y="310" as="sourcePoint"/>
            <mxPoint x="550" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message 5: Service B → Service A (return) -->
        <mxCell id="sq-msg-5" value="5. [Result]" style="html=1;endArrow=open;endFill=0;edgeStyle=elbowEdgeStyle;elbow=vertical;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="350" as="sourcePoint"/>
            <mxPoint x="350" y="350" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message 6: Service A → Actor (return) -->
        <mxCell id="sq-msg-6" value="6. [Response to User]" style="html=1;endArrow=open;endFill=0;edgeStyle=elbowEdgeStyle;elbow=vertical;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="400" as="sourcePoint"/>
            <mxPoint x="140" y="400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Add more messages below — copy a message block and increment y by ~60 -->
        <mxCell id="sq-add-more" value="↓ Add more messages here" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=2;fontSize=9;fontFamily=Helvetica;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="420" height="25" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="sq-leg-sync" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="900" as="sourcePoint"/>
            <mxPoint x="140" y="900" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-leg-sync-lbl" value="Synchronous call" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="150" y="893" width="130" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="sq-leg-async" value="" style="endArrow=block;endFill=1;dashed=1;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="920" as="sourcePoint"/>
            <mxPoint x="140" y="920" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-leg-async-lbl" value="Async / external call" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="150" y="913" width="130" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="sq-leg-return" value="" style="endArrow=open;endFill=0;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="940" as="sourcePoint"/>
            <mxPoint x="140" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-leg-return-lbl" value="Return / response" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="150" y="933" width="130" height="16" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
