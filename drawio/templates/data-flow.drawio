<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="Data Flow" id="df-template">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="df-title" value="[Data Flow Title]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="727" height="40" as="geometry"/>
        </mxCell>

        <!-- Level label -->
        <mxCell id="df-level" value="[Level 1 DFD — replace with your flow]" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=2;fontSize=10;fontFamily=Helvetica;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="727" height="20" as="geometry"/>
        </mxCell>

        <!-- External Entities (rectangles, grey border) -->
        <mxCell id="df-ext-1" value="[External Entity A]&#xa;(e.g. Customer / Channel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="df-ext-2" value="[External Entity B]&#xa;(e.g. CRM / 3rd-Party)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="df-ext-3" value="[External Entity C]&#xa;(e.g. Reporting System)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="607" y="400" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- Processes (circles/ellipses) -->
        <mxCell id="df-proc-1" value="1.0&#xa;[Receive &amp; Validate Input]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="160" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="df-proc-2" value="2.0&#xa;[Process / Transform Data]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="380" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="df-proc-3" value="3.0&#xa;[Output / Deliver Results]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="600" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Data Stores (open-ended rectangles) -->
        <mxCell id="df-store-1" value="D1  [Primary Data Store]&#xa;(e.g. PostgreSQL / CIM)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="160" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="df-store-2" value="D2  [Secondary Store]&#xa;(e.g. Redis / Cache)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="580" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Data flows (labeled arrows) -->
        <!-- ext-1 (right) → proc-1 (left): horizontal L→R -->
        <mxCell id="df-flow-1" value="[Input data / request]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-ext-1" target="df-proc-1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-1 (bottom) → proc-2 (top): vertical T→B -->
        <mxCell id="df-flow-2" value="[Validated records]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="df-proc-1" target="df-proc-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-2 (bottom) → proc-3 (top): vertical T→B -->
        <mxCell id="df-flow-3" value="[Processed output]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="df-proc-2" target="df-proc-3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-3 (left) → ext-2 (right): horizontal R→L -->
        <mxCell id="df-flow-4" value="[Delivered results]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-proc-3" target="df-ext-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-1 (right) → store-1 (left): horizontal L→R -->
        <mxCell id="df-flow-5" value="[Store record]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-proc-1" target="df-store-1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- store-1 (bottom) → proc-2 (right): store below-right of proc-2 -->
        <mxCell id="df-flow-6" value="[Retrieve record]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;dashed=1;fontFamily=Helvetica;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-store-1" target="df-proc-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-2 (right) → ext-3 (left): horizontal L→R -->
        <mxCell id="df-flow-7" value="[Report data]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-proc-2" target="df-ext-3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- proc-3 (right) → store-2 (left): horizontal L→R -->
        <mxCell id="df-flow-8" value="[Cache results]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="df-proc-3" target="df-store-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="df-leg-ext" value="External Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;fontColor=#424242;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="120" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="df-leg-proc" value="Process" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="200" y="865" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="df-leg-store" value="D#  Data Store" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="868" width="140" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="df-leg-flow" value="" style="endArrow=open;endFill=0;html=1;strokeWidth=2;fontFamily=Helvetica;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="885" as="sourcePoint"/>
            <mxPoint x="560" y="885" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="df-leg-flow-lbl" value="Data Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="570" y="878" width="80" height="16" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
